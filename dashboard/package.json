{
  "name": "argus-dashboard",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist .astro",
    "prepare": "bun simple-git-hooks",
    "ci": "bun run typecheck && bun run lint && bun test && bun run build"
  },
  "dependencies": {
    "@astrojs/solid-js": "^5.1.3",
    "astro": "^5.18.0",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@tailwindcss/vite": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lint-staged": "^16.3.2",
    "simple-git-hooks": "^2.11.1",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.2"
  },
  "simple-git-hooks": {
    "pre-commit": "cd dashboard && bunx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,astro}": [
      "bunx biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,css,md}": [
      "bunx biome format --write --no-errors-on-unmatched"
    ]
  }
}
